# Copy to .env before running docker compose up -d.
TZ=America/New_York
WEATHERSTAR_LAT=38.9072
WEATHERSTAR_LON=-77.0369
WEATHERSTAR_LOCATION_LABEL=Washington
# Optional state label override; empty uses the NOAA location response.
WEATHERSTAR_LOCATION_STATE=
WEATHERSTAR_PORT=8080
# Set to the address viewers can reach when watching from another device.
WEATHERSTAR_PUBLIC_URL=http://localhost:8080
WEATHERSTAR_IDLE_SECONDS=120
# Portable default. The optional compose.vaapi.yaml selects vaapi-low-power.
WEATHERSTAR_ENCODER=software
# Host render node and its numeric group ID, only needed with compose.vaapi.yaml.
WEATHERSTAR_VAAPI_DEVICE=/dev/dri/renderD128
# WEATHERSTAR_RENDER_GID=REPLACE_WITH_HOST_RENDER_GROUP_ID
# Ordered, comma-separated page names. Remove pages to disable their optional feeds.
WEATHERSTAR_PAGES=current,local,extended,hourly,weekend,sunmoon,aqi,uv,radar,temperature-history,precipitation-history,news
# Optional publisher RSS feed. Empty leaves the news page unavailable.
WEATHERSTAR_NEWS_RSS_URL=
WEATHERSTAR_NEWS_SOURCE=Local News
# Optional path INSIDE the container to a user-supplied music file.
# Mount your own audio in compose.yaml before setting this; empty uses silent AAC.
WEATHERSTAR_MUSIC_FILE=
# Add traffic to WEATHERSTAR_PAGES and set your regional RSS feed below.
# Houston example: https://traffic.houstontranstar.org/data/rss/incidents_rss.xml
WEATHERSTAR_TRAFFIC_RSS_URL=
WEATHERSTAR_TRAFFIC_SOURCE=Local Traffic
# Optional maps: add traffic-flow and/or traffic-bottlenecks to WEATHERSTAR_PAGES.
# Included regional example: /app/config/traffic/houston.json
# Leave empty when maps are disabled. Custom configurations need a read-only mount.
WEATHERSTAR_TRAFFIC_MAP_CONFIG=
